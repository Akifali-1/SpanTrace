# API
SPANTRACE_DATABASE_URL=sqlite:///./agentscope.db
SPANTRACE_CORS_ORIGINS=http://localhost:3070
SPANTRACE_MAX_EVENT_BYTES=262144
SPANTRACE_RETENTION_DAYS=90

# The web app uses these server-side to proxy requests to the API.
SPANTRACE_API_URL=http://localhost:8070
SPANTRACE_API_KEY=replace-with-a-project-key

# SDK clients
SPANTRACE_PROJECT_ID=replace-with-project-id
SPANTRACE_CAPTURE_PAYLOADS=false
SPANTRACE_STRICT=false

# Controlled Task 4 execution worker. The API only launches Docker; imported
# source is loaded inside the worker container, never in FastAPI.
SPANTRACE_EXECUTION_WORKER_IMAGE=spantrace-worker:0.1.0
SPANTRACE_EXECUTION_WORKER_API_URL=http://host.docker.internal:8070
SPANTRACE_EXECUTION_TIMEOUT_SECONDS=120
SPANTRACE_EXECUTION_MEMORY_MB=256
SPANTRACE_EXECUTION_CPU_LIMIT=1.0
SPANTRACE_EXECUTION_PIDS_LIMIT=64
SPANTRACE_EXECUTION_LOG_BYTES=262144
SPANTRACE_EXECUTION_INPUT_BYTES=65536

# API
SPANTRACE_DATABASE_URL=sqlite:///./agentscope.db
SPANTRACE_CORS_ORIGINS=http://localhost:3070
SPANTRACE_MAX_EVENT_BYTES=262144
SPANTRACE_RETENTION_DAYS=90

# The web app uses these server-side to proxy requests to the API.
SPANTRACE_API_URL=http://localhost:8070
SPANTRACE_API_KEY=replace-with-a-project-key

# SDK clients
SPANTRACE_PROJECT_ID=replace-with-project-id
SPANTRACE_CAPTURE_PAYLOADS=false
SPANTRACE_STRICT=false
